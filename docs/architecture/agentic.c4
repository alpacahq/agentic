        okf 'docs/okf/system.md'
        allium 'none: no .allium specs exist in this repository'
        evidence 'plugins/alpaca-broker/.claude-plugin/plugin.json, plugins/alpaca-broker/.codex-plugin/plugin.json, plugins/alpaca-broker/.cursor-plugin/plugin.json'
      }
    }

    marketplace -[uses]-> trading_plugin 'lists as plugin source ./plugins/alpaca-trading (.claude-plugin/marketplace.json)'
    marketplace -[uses]-> broker_plugin 'lists as plugin source ./plugins/alpaca-broker (.claude-plugin/marketplace.json)'
  }

  ext_mcp_clients = external 'MCP clients (Cursor, Claude Code, Codex, VS Code)' {
    #generated #external
    description 'Agent clients. Plugin install path: Cursor, Claude Code, Codex only (README.md:42). Manual remote-MCP configuration path: those three plus VS Code, documented for the Broker MCP only (README.md:199-218). Evidence: README.md ("Agent Plugins", "Manual Remote MCP Configuration")'
  }
  ext_alpaca_trading_mcp = external 'Alpaca Trading MCP (hosted)' {
    #generated #external
    description 'Hosted OAuth-protected MCP endpoints for the Trading and Market Data APIs: api.alpaca.markets/mcp (live) and paper-api.alpaca.markets/mcp (paper). Evidence: plugins/alpaca-trading/.claude-plugin/plugin.json, README.md'
  }
  ext_alpaca_broker_mcp = external 'Alpaca Broker MCP (hosted)' {
    #generated #external
    description 'Hosted OAuth-protected MCP endpoints for the Broker API: broker-api.alpaca.markets/mcp (live) and broker-api.sandbox.alpaca.markets/mcp (sandbox). Evidence: plugins/alpaca-broker/.claude-plugin/plugin.json, README.md'
  }

  ext_alpaca_mcp_server_local = external 'Alpaca Trading MCP Server (self-hosted)' {
    #generated #external
    description 'Open-source Trading MCP server (alpacahq/alpaca-mcp-server) run locally with API-key authentication; this repository only points users to it. Evidence: README.md:220-222, README.md:7-12'
  }
  ext_alpaca_trading_cli = external 'Alpaca Trading CLI' {
    #generated #external
    description 'Terminal CLI over the Trading and Market Data APIs for scripts, CI, and focused agent actions; this repository only points users to it. Evidence: README.md:224-228, README.md:7-12'
  }

  ext_mcp_clients -[reads]-> agentic.marketplace 'imports marketplace alpacahq/agentic and installs plugins (README.md)'
  agentic.trading_plugin -[uses]-> ext_alpaca_trading_mcp 'declares live and paper Trading MCP endpoints for the installing client (plugins/alpaca-trading/.claude-plugin/plugin.json)'
  agentic.broker_plugin -[uses]-> ext_alpaca_broker_mcp 'declares live and sandbox Broker MCP endpoints for the installing client (plugins/alpaca-broker/.claude-plugin/plugin.json)'

  developer_user = person 'Alpaca account holder / agent developer' {
    description 'Person with an Alpaca account who connects an AI agent to Alpaca APIs. Evidence: README.md ("Prerequisites")'
  }
  developer_user -[uses]-> agentic 'follows setup instructions, installs plugins, completes OAuth flows (README.md)'
  developer_user -[uses]-> ext_alpaca_mcp_server_local 'alternative to hosted MCP, API-key auth; documented setup path only (README.md:220-222)'
  developer_user -[uses]-> ext_alpaca_trading_cli 'alternative command-line setup path documented by this repository (README.md:224-228)'
}

