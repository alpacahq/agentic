    broker_plugin = container 'alpaca-broker plugin' {
      #generated
      description 'Plugin manifests (Claude Code, Codex, Cursor variants) that register the hosted Broker MCP servers — live and sandbox. Evidence: plugins/alpaca-broker/.claude-plugin/plugin.json'
